# Settings for running Akari with docker compose.
# Copy this to .env and adjust:
#   cp .env.example .env

# --- Database -----------------------------------------------------------
POSTGRES_USER=akari
POSTGRES_PASSWORD=change_me
POSTGRES_DB=akari
POSTGRES_SSLMODE=disable

# --- Akari --------------------------------------------------------------
# The host port the persona's HTTP server is published on.
AKARI_PORT=8080

# The persona's pacing and its seed. What the persona is like — how it feels,
# what draws it, how well it follows through, how much it forgets — belongs to
# the persona itself, not here, so none of that is settable from the outside.
AKARI_PERSONA_NAME=akari
# The seed makes its wandering attention reproducible: the same seed replays
# the same run.
AKARI_PERSONA_SEED=1
# How often it comes round to itself when nothing is prodding it.
AKARI_PERSONA_INTERVAL=3s
# How often it settles the day: compacting memories and letting the faintest go.
AKARI_PERSONA_NIGHTLY=24h

# --- Optional extras ----------------------------------------------------
# Only used by `docker compose --profile extras up`.
NOCODB_DB=nocodb
NC_AUTH_JWT_SECRET=
NC_SENTRY_DSN=
NC_DISABLE_TELE=true
CLOUDFLARE_TUNNEL_TOKEN=
