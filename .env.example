# Optional Docker Compose host port. Compose reads a root .env automatically.
AKARI_PORT=8080

# Local Go/GoLand host state directory (relative to the process working directory).
# Compose sets /data explicitly; this does not select an external store.
AKARI_DATA_DIR=data
# Local management listener. Compose sets :8082 explicitly and publishes only to localhost.
AKARI_ADMIN_ADDR=127.0.0.1:8082
AKARI_ADMIN_PORT=8082

# Disable the console's application-level token check only behind a trusted network or auth proxy.
AKARI_ADMIN_AUTH_DISABLED=false

# Optional existing Git worktree for docs/*.md and design/*.md.
# Empty: create a dedicated local Git repository under AKARI_DATA_DIR/documentation.
# For Docker, mount the worktree and use its container path in a Compose override.
AKARI_DOCS_REPO=
