AKARI_ADDR=:8080

# The persona the program runs. What it is like (how it feels, what draws
# it, how well it follows through) belongs to the persona itself, not here;
# only its pacing and its seed are deployment settings.
AKARI_PERSONA_NAME=akari
AKARI_PERSONA_SEED=1
AKARI_PERSONA_INTERVAL=3s
AKARI_PERSONA_NIGHTLY=24h

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=akari
POSTGRES_SSLMODE=disable

LOG_LEVEL=info
